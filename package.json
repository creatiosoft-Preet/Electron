{
  "name": "wtl-desktop",
  "version": "5.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.wtl.desktop",
    "productName": "WTL",
    "files": [
      "build/**/*",
      "main.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icons/icon.png",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icons/icon.png",
      "category": "public.app-category.games"
    }
  }
}